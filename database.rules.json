{
  "rules": {
    ".read": false,
    ".write": false,

    "liveLocations": {
      "$busId": {
        ".read": "auth != null",
        ".write": "auth != null && newData.child('driverId').val() === auth.uid",
        ".validate": "newData.hasChildren(['lat', 'lng', 'timestamp', 'tripId', 'driverId'])",
        "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "speed": { ".validate": "newData.val() == null || newData.isNumber()" },
        "heading": { ".validate": "newData.val() == null || newData.isNumber()" },
        "accuracy": { ".validate": "newData.val() == null || newData.isNumber()" },
        "timestamp": { ".validate": "newData.isNumber()" },
        "tripId": { ".validate": "newData.isString()" },
        "driverId": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "$other": { ".validate": false }
      }
    },

    "driverStatus": {
      "$driverId": {
        ".read": "auth != null",
        ".write": "auth != null && $driverId === auth.uid",
        ".validate": "newData.hasChildren(['online', 'lastSeen'])",
        "online": { ".validate": "newData.isBoolean()" },
        "lastSeen": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
