rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && myRole() == 'admin';
    }

    function isTeacher() {
      return signedIn() && myRole() == 'teacher';
    }

    function isStudent() {
      return signedIn() && myRole() == 'student';
    }

    function isDriver() {
      return signedIn() && myRole() == 'driver';
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function teachesClass(classId) {
      return isTeacher() &&
        classId in get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.classIds;
    }

    // Attendance is restricted to the class's incharge teacher specifically —
    // narrower than teachesClass(), which just means they teach some period
    // there.
    function isClassIncharge(classId) {
      return isTeacher() &&
        get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.isClassTeacherOf == classId;
    }

    function myStudentClass() {
      return get(/databases/$(database)/documents/students/$(request.auth.uid)).data.classId;
    }

    // ---- users: role lookup doc, one per auth account ----
    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // ---- students ----
    match /students/{studentId} {
      allow read: if isAdmin() || isMe(studentId) || (isTeacher() && teachesClass(resource.data.classId));
      // Students may self-edit a narrow set of contact fields on their own
      // profile; everything else (name, roll number, classId, grades-adjacent
      // fields) stays admin-only.
      allow update: if isAdmin() || (
        isMe(studentId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['phone', 'address', 'emergencyContactName', 'emergencyContactPhone', 'emergencyContactRelation', 'photoUrl']
        )
      );
      allow create, delete: if isAdmin();
    }

    // ---- teachers ----
    match /teachers/{teacherId} {
      allow read: if isAdmin() || isMe(teacherId) || isTeacher() || isStudent();
      allow write: if isAdmin();
    }

    // ---- classes ----
    match /classes/{classId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- timetable ----
    match /timetable/{entryId} {
      allow read: if signedIn();
      allow write: if isAdmin() || teachesClass(request.resource.data.classId) || teachesClass(resource.data.classId);
    }

    // ---- homework + submissions ----
    match /homework/{homeworkId} {
      allow read: if isAdmin() ||
        (isTeacher() && teachesClass(resource.data.classId)) ||
        (isStudent() && myStudentClass() == resource.data.classId);
      allow create: if isAdmin() || (isTeacher() && teachesClass(request.resource.data.classId));
      allow update, delete: if isAdmin() || (isTeacher() && teachesClass(resource.data.classId));

      match /submissions/{studentId} {
        allow read: if isAdmin() || isMe(studentId) ||
          (isTeacher() && teachesClass(get(/databases/$(database)/documents/homework/$(homeworkId)).data.classId));
        allow create, update: if isMe(studentId) ||
          (isTeacher() && teachesClass(get(/databases/$(database)/documents/homework/$(homeworkId)).data.classId));
      }
    }

    // ---- exams ----
    match /exams/{examId} {
      allow read: if isAdmin() ||
        (isTeacher() && teachesClass(resource.data.classId)) ||
        (isStudent() && myStudentClass() == resource.data.classId);
      allow write: if isAdmin() || (isTeacher() && teachesClass(request.resource.data.classId));
    }

    // ---- results ----
    match /results/{resultId} {
      allow read: if isAdmin() || isMe(resource.data.studentId) ||
        (isTeacher() && teachesClass(resource.data.classId));
      allow write: if isAdmin() || (isTeacher() && teachesClass(request.resource.data.classId));
    }

    // ---- notices ----
    match /notices/{noticeId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isTeacher();
    }

    // ---- noticeDrafts (AI Notice Writer "Save Draft" - never shown to
    // students/parents, so it's kept out of the public notices collection) ----
    match /noticeDrafts/{draftId} {
      allow read, write: if isAdmin() || isTeacher();
    }

    // ---- studyMaterials ----
    match /studyMaterials/{materialId} {
      allow read: if isAdmin() ||
        (isTeacher() && teachesClass(resource.data.classId)) ||
        (isStudent() && myStudentClass() == resource.data.classId);
      allow write: if isAdmin() || (isTeacher() && teachesClass(request.resource.data.classId));
    }

    // ---- calendarEvents ----
    match /calendarEvents/{eventId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- attendance (doc id = "{studentId}_{yyyy-mm-dd}") ----
    match /attendance/{docId} {
      allow read: if isAdmin() || isMe(resource.data.studentId) ||
        (isTeacher() && teachesClass(resource.data.classId));
      allow write: if isAdmin() ||
        (isTeacher() && isClassIncharge(request.resource.data.classId)) ||
        (isTeacher() && resource != null && isClassIncharge(resource.data.classId));
    }

    // ---- per-user notifications ----
    match /notifications/{uid}/items/{itemId} {
      allow read, update: if isMe(uid) || isAdmin();
      allow create: if isAdmin() || isTeacher();
    }

    // ---- audit trail for the admin console's System Logs page ----
    match /auditLogs/{logId} {
      allow read, create: if isAdmin();
    }

    // ---- school-wide settings (singleton docs, e.g. settings/school) ----
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- fee structure per class (school-defined amounts) ----
    match /feeStructures/{classId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- per (student, installment) current fee standing ----
    match /studentFeeRecords/{recordId} {
      allow read: if isAdmin() || isMe(resource.data.studentId) ||
        (isTeacher() && teachesClass(resource.data.classId));
      allow write: if isAdmin();
    }

    // ---- immutable payment transactions / receipts - never updated or
    // deleted once created, so admins and the paying student can always
    // trust a receipt they've already seen ----
    match /feePayments/{paymentId} {
      allow read: if isAdmin() || isMe(resource.data.studentId) ||
        (isTeacher() && teachesClass(resource.data.classId));
      allow create: if isAdmin();
    }

    // ---- sequential receipt-number counters, one per academic session ----
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // ---- drivers (one doc per driver, doc id = auth uid) ----
    match /drivers/{driverId} {
      allow read: if isAdmin() || isMe(driverId);
      allow create, delete: if isAdmin();
      // A driver may only update their own FCM token list; every other
      // field (name, phone, assignedBusId) stays admin-only.
      allow update: if isAdmin() || (
        isMe(driverId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens'])
      );
    }

    // ---- busStops (master list of stop locations, reused across routes) ----
    match /busStops/{stopId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- buses ----
    match /buses/{busId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      // The assigned driver may flip status/currentTripId when starting or
      // ending a trip; every other field (driver/route assignment, etc.)
      // stays admin-only.
      allow update: if isAdmin() || (
        isDriver() &&
        resource.data.driverId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'currentTripId'])
      );
    }

    // ---- routes (ordered stop sequence for one bus's morning/afternoon shift) ----
    match /routes/{routeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- trips (one Start Trip -> End Trip cycle) ----
    match /trips/{tripId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (isDriver() && request.resource.data.driverId == request.auth.uid);
      allow update: if isAdmin() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
